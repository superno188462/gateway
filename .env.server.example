# Copy this file to .env on the server. Never commit the completed .env.
# DATABASE_URL may point to a remote PostgreSQL or, with the Compose host-gateway
# alias, PostgreSQL installed on this same server (host.docker.internal).
DATABASE_URL=postgresql+asyncpg://gateway:URL_ENCODED_PASSWORD@host.docker.internal:5432/gateway
APP_ENV=production
APP_ROOT_PATH=/gateway
LOG_LEVEL=INFO
LOG_FILE_PATH=/var/log/gateway/gateway.log
LOG_BACKUP_COUNT=30

# Set both on first deployment. After the admin has been bootstrapped, they may
# be removed; keep JWT_SECRET_KEY stable for existing sessions.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_use_a_long_random_password
JWT_SECRET_KEY=CHANGE_ME_at_least_32_random_characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Required for project API Keys and encrypted LLM provider credentials.
API_KEY_SECRET_KEY=CHANGE_ME_at_least_32_random_characters
LLM_PROVIDER_SECRET_KEY=CHANGE_ME_at_least_32_random_characters
DEFAULT_LLM_MONTHLY_TOKEN_LIMIT=100000
DEFAULT_EMBEDDING_MONTHLY_TOKEN_LIMIT=100000
