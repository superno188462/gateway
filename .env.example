# 应用运行时使用服务器 PostgreSQL；真实密码不能写入仓库。
DATABASE_URL=postgresql+asyncpg://数据库用户:数据库密码@119.45.48.180:5432/数据库名
APP_ENV=development
LOG_LEVEL=INFO

# A1：首次启动时可同时配置，创建或更新唯一管理员；两项必须同时配置或同时留空。
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-strong-password

# A1：至少 32 位随机字符串，用于签发管理员 JWT。
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
