# 应用运行时使用服务器 PostgreSQL；真实密码不能写入仓库。
DATABASE_URL=postgresql+asyncpg://数据库用户:数据库密码@119.45.48.180:5432/数据库名
APP_ENV=development
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/gateway.log
LOG_BACKUP_COUNT=30

# A1：首次启动时可同时配置，创建或更新唯一管理员；两项必须同时配置或同时留空。
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-strong-password

# A1：至少 32 位随机字符串，用于签发管理员 JWT。
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# A4：新注册用户的默认 LLM 月度 token 上限；管理员可按用户调整，0 表示不自动授予。
DEFAULT_LLM_MONTHLY_TOKEN_LIMIT=0
# A9：新注册用户的默认 Embedding 月 token 上限；管理员可按用户调整，0 表示不自动授予。
DEFAULT_EMBEDDING_MONTHLY_TOKEN_LIMIT=0

# A3：用于 API Key 摘要和加密存储的主密钥，至少 32 个字符；生产环境必须稳定保存。
# owner/editor 可随时查看完整 Key，因此数据库存的是加密密文，不是明文。
# 轮换此值会导致已有 API Key 无法解密和验证。
# 生成命令：uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# API_KEY_SECRET_KEY=

# LLM：用于加密数据库中的第三方供应商 API Key，至少 32 个字符；与上方项目 API Key 主密钥分开保存。
# 管理员在控制台配置供应商 API Key 和 Base URL；此主密钥只由服务端环境变量保存。
# LLM_PROVIDER_SECRET_KEY=
